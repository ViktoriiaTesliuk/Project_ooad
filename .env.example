# Local development. On Lambda, set these as environment variables instead
# (or put SECRET_KEY, GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET and
# GEMINI_API_KEY in the Secrets Manager secret named by APP_SECRETS_ARN).
SECRET_KEY=
PUBLIC_BASE_URL=http://localhost:5000
SESSION_COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
AWS_DEFAULT_REGION=
RDS_RESOURCE_ARN=
RDS_SECRET_ARN=
RDS_DATABASE=pocket_ledger
GEMINI_API_KEY=
APP_SECRETS_ARN=
